{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!!dist",
			"!!out",
			"!!node_modules",
			"!!public/**/*.png",
			"!!public/**/*.jpg",
			"!!public/**/*.jpeg",
			"!!public/**/*.svg",
			"!!public/**/*.webp",
			"!!public/**/*.ico",
			"!!.next",
			"!!src/assets"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useConsistentCurlyBraces": "error",
				"noNonNullAssertion": "error"
			},
			"correctness": {
				"noUnusedVariables": "error"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
